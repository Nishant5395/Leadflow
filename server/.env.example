
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# SQLite file location. In Docker this points at a mounted volume.
DATABASE_PATH=./data/leadflow.db

# Load demo leads into an empty database on first start.
SEED_DEMO_DATA=true

# Number of reverse proxies in front of the app (Render / Railway: 1). Affects client IP detection for rate limiting.
TRUST_PROXY=0


